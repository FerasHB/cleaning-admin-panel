# Supabase configuration for the Web Admin Panel.
# This is a TEMPLATE — real values belong ONLY in a local .env.local
# (gitignored), never in this repository.

# Project URL (public, non-sensitive).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# CLIENT key: the publishable/anon key ONLY (sb_publishable_… or a legacy
# anon JWT). This key is meant for the browser and is enforced by RLS.
#
# NEVER put a secret/service-role key here:
#   - sb_secret_… or a service_role JWT bypasses RLS entirely.
#   - Everything prefixed NEXT_PUBLIC_ ends up in the browser bundle (public).
#   - The service-role/secret key belongs EXCLUSIVELY server-side, inside
#     Edge Functions in the backend/Mobile repository — never in this
#     Web repository's client code.
#
# lib/supabase/keyGuard.ts refuses to start the browser client if a
# privileged key is detected here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# For local Web development, point these at TaskOps STAGING
# (https://legzogskvcmicdgowyax.supabase.co), not Production. See README.md
# for the current Staging/Production separation policy.
